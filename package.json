{
  "name": "serverless-data-migration",
  "version": "0.1.0",
  "private": true,
  "description": "A serverless pipeline for migrating live records between data models on AWS: batched, idempotent, resumable and verified.",
  "author": "Ahmed Alhibshi (https://ahmedalhibshi.dev)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "emulators:up": "docker compose up -d --wait",
    "emulators:down": "docker compose down",
    "seed": "tsx scripts/seedSubscribers.ts",
    "deploy": "serverless deploy",
    "remove": "serverless remove",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "serverless": "4.44.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
